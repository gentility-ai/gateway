#!/usr/bin/env bash
# Builds one gateway bundle into dist/<bundle>/: upstream's linux_amd64
# archive byte for byte, our plugin built against that release, and an
# unsigned manifest.json. Signing is the publish job's alone.
#
#   scripts/build            # upstream's latest release
#   scripts/build 8.0.60     # a given one
#
# Prints "skip" and exits 0 when that bundle is already published, unless
# FORCE is set (CI builds every change, published or not). Runs the
# plugin tests and, on Linux, the contract test against the release. Needs
# gh, go and jq.
set -euo pipefail

upstream=router-for-me/CLIProxyAPI
self=${GITHUB_REPOSITORY:-gentility-ai/gateway}
root=$(cd "$(dirname "$0")/.." && pwd)
out() { [ -n "${GITHUB_OUTPUT:-}" ] && echo "$1=$2" >> "$GITHUB_OUTPUT"; true; }

version=${1:-$(gh release view -R "$upstream" --json tagName --jq .tagName)}
version=${version#v}
plugin=$(grep -o '"Version":"[^"]*"' "$root/cliproxy-usage/main.go" | head -1 | cut -d'"' -f4)
bundle="$version-$plugin"
out bundle "$bundle"

if [ -z "${FORCE:-}" ] && gh release view "gateway-$bundle" -R "$self" >/dev/null 2>&1; then
  echo "skip: gateway-$bundle is published"
  out skip true
  exit 0
fi
out skip false

dist="$root/dist/$bundle"
rm -rf "$dist" && mkdir -p "$dist"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

archive="CLIProxyAPI_${version}_linux_amd64.tar.gz"
gh release download "v$version" -R "$upstream" -p "$archive" -p checksums.txt -D "$scratch"
want=$(awk -v a="$archive" '$2 == a { print $1 }' "$scratch/checksums.txt")
got=$(sha256sum "$scratch/$archive" 2>/dev/null || shasum -a 256 "$scratch/$archive")
if [ -z "$want" ] || [ "${got%% *}" != "$want" ]; then
  echo "$archive does not match upstream's checksums.txt" >&2
  exit 1
fi
cp "$scratch/$archive" "$dist/"

(cd "$root/cliproxy-usage" &&
  go get "github.com/router-for-me/CLIProxyAPI/v8@v$version" &&
  go mod tidy &&
  go vet ./... && go test -count=1 ./... &&
  CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -buildmode=c-shared -o "$dist/gentility-usage.so" . &&
  rm -f "$dist/gentility-usage.h")

if [ "$(uname -s)" = Linux ]; then
  mkdir "$scratch/proxy" && tar -xzf "$dist/$archive" -C "$scratch/proxy"
  (cd "$root/contract" &&
    CLIPROXY_BIN="$scratch/proxy/cli-proxy-api" USAGE_PLUGIN="$dist/gentility-usage.so" \
      go test -count=1 -v ./... | tee "$scratch/contract.log")
  grep -q -- '--- PASS: TestTheCallsTheServerMakes' "$scratch/contract.log"
else
  echo "not Linux: the contract test runs in CI" >&2
fi

# The changelog since the previous bundle's upstream release, lines that touch
# what the gateway depends on flagged.
watched='plugin|pluginabi|pluginhost|pluginstore|sdk|management|api-keys|quota|usage|auth|config'
previous=$(gh release list -R "$self" --limit 100 --json tagName --jq '.[].tagName' 2>/dev/null |
  sed -n 's/^gateway-\([0-9.]*\)-.*/\1/p' | sort -V | tail -1)
gh release list -R "$upstream" --limit 100 --json tagName --jq '.[].tagName' | sed 's/^v//' | sort -V |
  awk -v from="${previous:-$version}" -v to="$version" -v first="${previous:+no}" '
    function cmp(a, b,   x, y, i, n) {
      n = split(a, x, "."); split(b, y, ".")
      for (i = 1; i <= n; i++) if (x[i] + 0 != y[i] + 0) return x[i] + 0 < y[i] + 0 ? -1 : 1
      return 0
    }
    (first == "" && cmp($0, to) == 0) || (cmp($0, from) > 0 && cmp($0, to) <= 0)' |
  while read -r v; do
    gh release view "v$v" -R "$upstream" --json body --jq .body |
      awk '/^## Changelog/ { on = 1; next } /^## / { on = 0 } on && /^- /' |
      grep -v -E '^- Merge (pull request|branch)' |
      sed -E 's/^- //; s/ \([0-9a-f]{7,40}\)$//' |
      jq -R --arg w "$watched" '{text: ., flagged: (ascii_downcase | test("^[a-z]+\\((" + $w + ")[^)]*\\)"))}' |
      jq -s --arg v "$v" '{version: $v, lines: .}'
  done | jq -s . > "$scratch/changelog.json"

(cd "$root/bundle" && go run . manifest -dir "$dist" \
  -upstream-version "$version" -upstream-archive "$archive" -plugin-version "$plugin" \
  -commit "$(git -C "$root" rev-parse HEAD)" \
  -build "${GITHUB_SERVER_URL:-https://github.com}/$self/actions/runs/${GITHUB_RUN_ID:-local}" \
  -changelog "$scratch/changelog.json")
echo "built $dist"
