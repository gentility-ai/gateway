{
  "format": 1,
  "about": "The CLIProxyAPI calls gentility-core's Gentility.Sessions.OmpGateway makes, and no others. scope_canary must be refused 403 key_scope: it proves the plugin's key scope is live, and its model must be one an openai-compatibility login serves. A value in angle brackets is a placeholder: <key> a session key, <sentinel> the sentinel key, <management_key> the management key, <etag> the ETag the read answered with. A body is the JSON sent, with placeholders; null is no body.",
  "calls": [
    {
      "name": "add_key",
      "method": "PATCH",
      "path": "/v0/management/api-keys",
      "query": {},
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "x-management-key": "<management_key>"
      },
      "body": {"old": "<key>", "new": "<key>"}
    },
    {
      "name": "delete_key",
      "method": "DELETE",
      "path": "/v0/management/api-keys",
      "query": {"value": "<key>"},
      "headers": {
        "x-management-key": "<management_key>"
      },
      "body": null
    },
    {
      "name": "read_keys",
      "method": "GET",
      "path": "/v8/management/config/access/api-keys",
      "query": {},
      "headers": {
        "x-management-key": "<management_key>"
      },
      "body": null
    },
    {
      "name": "write_keys",
      "method": "PUT",
      "path": "/v8/management/config/access/api-keys",
      "query": {},
      "headers": {
        "accept": "application/json",
        "content-type": "application/json",
        "if-match": "<etag>",
        "x-management-key": "<management_key>"
      },
      "body": ["<sentinel>", "<key>"]
    },
    {
      "name": "probe_key",
      "method": "GET",
      "path": "/v1/models",
      "query": {},
      "headers": {
        "authorization": "Bearer <key>"
      },
      "body": null
    },
    {
      "name": "scope_canary",
      "method": "POST",
      "path": "/v1/chat/completions",
      "query": {},
      "headers": {
        "accept": "application/json",
        "authorization": "Bearer <sentinel>",
        "content-type": "application/json"
      },
      "body": {"model": "glm-5.3-flash", "max_tokens": 1, "messages": [{"role": "user", "content": "."}]}
    },
    {
      "name": "read_quota",
      "method": "GET",
      "path": "/v0/management/gentility-usage/record",
      "query": {},
      "headers": {
        "x-management-key": "<management_key>"
      },
      "body": null
    }
  ]
}
